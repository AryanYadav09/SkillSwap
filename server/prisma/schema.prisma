generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum MatchRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  COMPLETED
}

enum SessionStatus {
  PENDING
  SCHEDULED
  COMPLETED
  CANCELLED
  REJECTED
}

enum ReportStatus {
  PENDING
  RESOLVED
  REJECTED
}

enum NotificationType {
  MATCH_REQUEST
  MATCH_ACCEPTED
  MATCH_REJECTED
  SESSION_SCHEDULED
  SESSION_ACCEPTED
  SESSION_REJECTED
  REVIEW_ADDED
  NEW_MESSAGE
  SYSTEM
  MEETING_BOOKED
  MEETING_CANCELLED
  MEETING_RESCHEDULED
  MEETING_STARTING_SOON
}

enum MeetingStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BookingSlotStatus {
  AVAILABLE
  BOOKED
  CANCELLED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model User {
  id                       String           @id @default(cuid())
  name                     String
  username                 String           @unique
  email                    String           @unique
  password                 String
  profileImage             String?
  bio                      String?          @db.Text
  college                  String
  department               String
  semester                 String
  role                     Role             @default(USER)
  status                   UserStatus       @default(ACTIVE)
  isVerified               Boolean          @default(false)
  refreshToken             String?          @db.Text
  passwordResetToken       String?
  passwordResetTokenExpiry DateTime?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
  offeredSkills            UserOfferedSkill[]
  learningSkills           UserLearningSkill[]
  sentMatchRequests        MatchRequest[]   @relation("SentMatchRequests")
  receivedMatchRequests    MatchRequest[]   @relation("ReceivedMatchRequests")
  chatsAsUser1             Chat[]           @relation("ChatUser1")
  chatsAsUser2             Chat[]           @relation("ChatUser2")
  messages                 Message[]
  sessionsCreated          Session[]        @relation("SessionCreator")
  reviewsWritten           Review[]         @relation("WrittenReviews")
  reviewsReceived          Review[]         @relation("ReceivedReviews")
  notifications            Notification[]
  bookmarks                Bookmark[]       @relation("UserBookmarks")
  bookmarkedBy             Bookmark[]       @relation("BookmarkedUsers")
  submittedReports         Report[]         @relation("SubmittedReports")
  reportsAgainst           Report[]         @relation("ReportsAgainstUser")
  timezone                 String?
  availabilities           Availability[]
  bookedSlots              BookingSlot[]    @relation("BookedSlots")
  hostedMeetings           Meeting[]        @relation("HostedMeetings")
  guestMeetings            Meeting[]        @relation("GuestMeetings")

  @@map("users")
}

model Skill {
  id          String              @id @default(cuid())
  name        String
  category    String
  description String             @db.Text
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  offeredBy   UserOfferedSkill[]
  learners    UserLearningSkill[]

  @@unique([name, category])
  @@map("skills")
}

model UserOfferedSkill {
  id        String     @id @default(cuid())
  userId    String
  skillId   String
  level     SkillLevel
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill     Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@map("user_offered_skills")
}

model UserLearningSkill {
  id           String     @id @default(cuid())
  userId       String
  skillId      String
  goal         String     @db.Text
  currentLevel SkillLevel
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill        Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@map("user_learning_skills")
}

model MatchRequest {
  id         String             @id @default(cuid())
  senderId   String
  receiverId String
  status      MatchRequestStatus @default(PENDING)
  message     String?            @db.Text
  description String?            @db.Text
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  sender     User               @relation("SentMatchRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User               @relation("ReceivedMatchRequests", fields: [receiverId], references: [id], onDelete: Cascade)
  sessions   Session[]

  @@index([senderId, receiverId, status])
  @@map("match_requests")
}

model Chat {
  id        String    @id @default(cuid())
  user1Id   String
  user2Id   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user1     User      @relation("ChatUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2     User      @relation("ChatUser2", fields: [user2Id], references: [id], onDelete: Cascade)
  messages  Message[]

  @@unique([user1Id, user2Id])
  @@map("chats")
}

model Message {
  id        String    @id @default(cuid())
  chatId    String
  senderId  String
  message   String?   @db.Text
  imageUrl  String?
  isSeen    Boolean   @default(false)
  seenAt    DateTime?
  createdAt DateTime  @default(now())
  chat      Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender    User      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
  @@map("messages")
}

model Session {
  id             String        @id @default(cuid())
  meetingId      String        @unique @default(cuid())
  matchRequestId String
  createdById    String
  title          String
  description    String        @db.Text
  sessionDate    DateTime
  duration       Int
  status         SessionStatus @default(PENDING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  matchRequest   MatchRequest  @relation(fields: [matchRequestId], references: [id], onDelete: Cascade)
  createdBy      User          @relation("SessionCreator", fields: [createdById], references: [id], onDelete: Cascade)
  reviews        Review[]

  @@index([sessionDate, status])
  @@map("sessions")
}

model Review {
  id             String   @id @default(cuid())
  sessionId      String
  reviewerId     String
  reviewedUserId String
  rating         Int
  comment        String   @db.Text
  createdAt      DateTime @default(now())
  session        Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  reviewer       User     @relation("WrittenReviews", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewedUser   User     @relation("ReceivedReviews", fields: [reviewedUserId], references: [id], onDelete: Cascade)

  @@unique([sessionId, reviewerId])
  @@map("reviews")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String           @db.Text
  type      NotificationType @default(SYSTEM)
  entityId  String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model Bookmark {
  id               String   @id @default(cuid())
  userId           String
  bookmarkedUserId String
  createdAt        DateTime @default(now())
  user             User     @relation("UserBookmarks", fields: [userId], references: [id], onDelete: Cascade)
  bookmarkedUser   User     @relation("BookmarkedUsers", fields: [bookmarkedUserId], references: [id], onDelete: Cascade)

  @@unique([userId, bookmarkedUserId])
  @@map("bookmarks")
}

model Report {
  id             String       @id @default(cuid())
  reporterId     String
  reportedUserId String
  reason         String
  description    String       @db.Text
  status         ReportStatus @default(PENDING)
  adminNotes     String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  reporter       User         @relation("SubmittedReports", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser   User         @relation("ReportsAgainstUser", fields: [reportedUserId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("reports")
}

model Availability {
  id              String        @id @default(cuid())
  userId          String
  dayOfWeek       DayOfWeek
  startTime       String        // "HH:mm" format (local time reference)
  endTime         String        // "HH:mm" format
  timezone        String        // e.g. "Asia/Kolkata"
  isRecurring     Boolean       @default(true)
  isActive        Boolean       @default(true)
  specificDate    DateTime?     // for one-time slots
  meetingDuration Int           @default(30)  // minutes
  bufferMinutes   Int           @default(5)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingSlots    BookingSlot[]

  @@index([userId, isActive])
  @@index([dayOfWeek, isActive])
  @@map("availabilities")
}

model BookingSlot {
  id              String            @id @default(cuid())
  availabilityId  String
  startTime       DateTime          // absolute UTC datetime
  endTime         DateTime          // absolute UTC datetime
  status          BookingSlotStatus @default(AVAILABLE)
  bookedById      String?
  meetingId       String?           @unique
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  availability    Availability      @relation(fields: [availabilityId], references: [id], onDelete: Cascade)
  bookedBy        User?             @relation("BookedSlots", fields: [bookedById], references: [id], onDelete: SetNull)
  meeting         Meeting?

  @@unique([availabilityId, startTime, status])
  @@index([startTime, status])
  @@index([bookedById])
  @@map("booking_slots")
}

model Meeting {
  id              String        @id @default(cuid())
  meetingToken    String        @unique @default(cuid())
  hostUserId      String
  guestUserId     String
  bookingSlotId   String        @unique
  title           String        @default("Skill Exchange Session")
  startTime       DateTime
  endTime         DateTime
  timezone        String
  status          MeetingStatus @default(SCHEDULED)
  cancelledById   String?
  cancelReason    String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  hostUser        User          @relation("HostedMeetings", fields: [hostUserId], references: [id], onDelete: Cascade)
  guestUser       User          @relation("GuestMeetings", fields: [guestUserId], references: [id], onDelete: Cascade)
  bookingSlot     BookingSlot   @relation(fields: [bookingSlotId], references: [id], onDelete: Cascade)

  @@index([hostUserId, status])
  @@index([guestUserId, status])
  @@index([startTime, status])
  @@map("meetings")
}
